# Gemini API Configuration (Free tier supported)
# Leave blank to automatically use the high-performance deterministic offline fallback engine
GEMINI_API_KEY=

# Supabase Authentication
# Get these public values from Supabase Project Settings > API.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Platform Environment
NEXT_PUBLIC_APP_NAME="FlowOps"
NEXT_PUBLIC_APP_VERSION="1.0.0"
